# Server-side only — never expose to the browser.
# Required for the AI portfolio assistant (app/api/chat/route.ts).
OPENAI_API_KEY=

# Optional: override the default model used by the assistant.
# Defaults to gpt-4o-mini if unset. Use the model name supported by your OpenAI account.
OPENAI_MODEL=

# Optional: your deployed site URL, used for Open Graph/Twitter metadata resolution.
NEXT_PUBLIC_SITE_URL=
